{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(* --help *)",
      "Bash(* --version)",
      "Bash(ls*)",
      "Bash(pwd*)",
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(wc*)",
      "Bash(which*)",
      "Bash(diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git blame*)",
      "Bash(git stash list*)",
      "Bash(git tag*)",
      "Bash(git grep*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git fetch*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh auth status*)",
      "Bash(gh api repos/*/pulls/*/comments*)",
      "Bash(gh api repos/*/pulls/*/reviews*)",
      "Bash(gh api repos/*/issues/*/comments*)",
      "Bash(task --list*)",
      "Bash(docker ps*)"
    ],
    "additionalDirectories": [
        "~/work/.worktrees"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cat | bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {},
  "effortLevel": "xhigh",
  "teammateMode": "tmux"
}
