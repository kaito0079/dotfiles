# ==============================================================================
# メインコマンド
# ==============================================================================
# すべてのセットアップを実行（初期設定、リンク作成、macOS設定、パッケージインストール）
# 新規環境のセットアップ時に使用
all: init link defaults brew
	@echo "\033[0;32mすべてのセットアップが完了しました。\033[0m"

# ==============================================================================
# ヘルプコマンド
# ==============================================================================

# 利用可能なコマンド一覧を表示
help:
	@echo "\033[0;33m利用可能なコマンド:\033[0m"
	@echo "  \033[0;32mmake\033[0m または \033[0;32mmake all\033[0m     - すべてのセットアップを実行"
	@echo "  \033[0;32mmake init\033[0m        - macOSの初期設定を実行"
	@echo "  \033[0;32mmake link\033[0m       - ドットファイルのシンボリックリンクを作成"
	@echo "  \033[0;32mmake defaults\033[0m   - macOSのシステム設定を適用"
	@echo "  \033[0;32mmake brew\033[0m       - Homebrewでパッケージをインストール"
	@echo "  \033[0;32mmake update\033[0m     - スクリプトの実行権限を付与し、Brewfileを更新"
	@echo "  \033[0;32mmake help\033[0m       - このヘルプを表示"

# ==============================================================================
# 個別セットアップコマンド
# ==============================================================================

# macOSの初期設定を実行
# - Dockの設定（自動非表示、ホットコーナーなど）
# - Finderの設定（ステータスバー、パスバー、タブバーの表示）
# - キーボード設定（キーリピートの有効化など）
# - その他のmacOSシステム設定
init:
	@echo "\033[0;34m[初期設定] macOSの初期設定を実行します...\033[0m"
	@scripts/init.sh
	@echo "\033[0;32m[初期設定] 完了しました。\033[0m"

# ドットファイル（.bin/.??*）をホームディレクトリにシンボリックリンクとして作成
# - .gitconfig, .zshrc, aliases.zsh などの設定ファイルをリンク
# - 既存のファイルは上書きされる（-f オプション）
link:
	@echo "\033[0;34m[リンク作成] ドットファイルのシンボリックリンクを作成します...\033[0m"
	@scripts/link.sh
	@echo "\033[0;32m[リンク作成] 完了しました。\033[0m"


# Homebrewを使用してBrewfileに記載されているパッケージをインストール
# - brew bundle --global を実行
# - Brewfileに記載されているアプリケーション、ツール、caskを一括インストール
brew:
	@echo "\033[0;34m[パッケージインストール] Homebrewでパッケージをインストールします...\033[0m"
	@scripts/brew.sh
	@echo "\033[0;32m[パッケージインストール] 完了しました。\033[0m"

# ==============================================================================
# 更新・メンテナンスコマンド
# ==============================================================================

# スクリプトに実行権限を付与し、Brewfileを更新
# - scripts/ 内のすべてのスクリプトに実行権限を付与
# - 現在インストールされているパッケージを確認し、.Brewfileを更新
# - 新しくインストールしたパッケージを.Brewfileに反映
update:
	@echo "\033[0;34m[更新] スクリプトの実行権限を付与し、Brewfileを更新します...\033[0m"
	@scripts/update.sh
	@echo "\033[0;32m[更新] 完了しました。\033[0m"
