{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(* --help *)",
      "Bash(* --version)",
      "Bash(ls*)",
      "Bash(pwd*)",
      "Bash(cat*)",
      "Bash(grep*)",
      "Bash(find*)",
      "Bash(wc*)",
      "Bash(which*)",
      "Bash(diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git blame*)",
      "Bash(git stash list*)",
      "Bash(git tag*)",
      "Bash(git grep*)",
      "Bash(git ls-files*)",
      "Bash(git ls-tree*)",
      "Bash(git fetch*)",
      "Bash(gh pr list*)",
      "Bash(gh pr view*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr status*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue list*)",
      "Bash(gh issue view*)",
      "Bash(gh issue status*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh repo view*)",
      "Bash(gh workflow list*)",
      "Bash(gh workflow view*)",
      "Bash(gh release list*)",
      "Bash(gh release view*)",
      "Bash(gh auth status*)",
      "Bash(gh api repos/*/pulls/*/comments*)",
      "Bash(gh api repos/*/pulls/*/reviews*)",
      "Bash(gh api repos/*/issues/*/comments*)",
      "Bash(task --list*)",
      "Bash(docker ps*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:zenn.dev)",
      "WebFetch(domain:docs.slack.dev)",
      "WebFetch(domain:slack.com)",
      "Skill(commit-helper)"
    ],
    "additionalDirectories": [
      "~/work/.worktrees"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_todo_progress.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_claude_status_pill.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/aw_insights_notice.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_claude_status_pill.py"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_claude_status_pill.py"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_claude_status_pill.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/session_end_transcript_mirror.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_todo_progress.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_claude_status_pill.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_preview.py diff"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/markdown_open_in_cmux.sh"
          }
        ]
      },
      {
        "matcher": "TodoWrite",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/cmux_todo_progress.py"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "cat | bash ~/.claude/hooks/statusline_entry.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {},
  "outputStyle": "Explanatory",
  "sandbox": {
    "allowUnsandboxedCommands": true,
    "excludedCommands": [
      "task *",
      "docker *",
      "docker-compose *"
    ]
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "teammateMode": "tmux"
}
